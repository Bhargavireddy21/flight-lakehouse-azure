{
  "name": "ds_bts_zip",
  "properties": {
    "description": "One month of on-time performance data, as a zip on the BTS site.",
    "linkedServiceName": { "referenceName": "ls_http_bts", "type": "LinkedServiceReference" },
    "parameters": {
      "year": { "type": "string" },
      "month": { "type": "string" }
    },
    "type": "Binary",
    "typeProperties": {
      "location": {
        "type": "HttpServerLocation",
        "relativeUrl": {
          "value": "@concat('PREZIP/On_Time_Reporting_Carrier_On_Time_Performance_1987_present_', dataset().year, '_', dataset().month, '.zip')",
          "type": "Expression"
        }
      },
      "compression": { "type": "ZipDeflate" }
    }
  }
}
