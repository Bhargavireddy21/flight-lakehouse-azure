{
  "name": "flightlake_batch",
  "description": "Bronze -> silver -> gold on serverless compute. Triggered by the Data Factory pipeline pl_flights_batch. Notebooks are read from GitHub, so the job does not depend on anyone's workspace folder.",
  "git_source": {
    "git_url": "https://github.com/Bhargavireddy21/flight-lakehouse-azure",
    "git_provider": "gitHub",
    "git_branch": "main"
  },
  "parameters": [
    { "name": "catalog", "default": "flightlake" }
  ],
  "tasks": [
    {
      "task_key": "bronze",
      "notebook_task": { "notebook_path": "notebooks/01_bronze_ingest", "source": "GIT" }
    },
    {
      "task_key": "silver",
      "depends_on": [{ "task_key": "bronze" }],
      "notebook_task": { "notebook_path": "notebooks/02_silver_transform", "source": "GIT" }
    },
    {
      "task_key": "gold",
      "depends_on": [{ "task_key": "silver" }],
      "notebook_task": { "notebook_path": "notebooks/03_gold_star_schema", "source": "GIT" }
    }
  ],
  "max_concurrent_runs": 1
}
